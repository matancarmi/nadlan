# Copy to .env for local dev. On Railway, set these as service variables instead.

# Postgres connection string on Railway (auto-provided as DATABASE_URL by the
# Postgres plugin). Leave unset locally to use a local SQLite file.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

APP_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-long-random-string
# false for local http:// dev; leave true (default) in production over https
SESSION_COOKIE_SECURE=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
ALERT_EMAIL_TO=matancarmi.mc@gmail.com
ALERT_EMAIL_FROM=your-gmail-address@gmail.com

FRONTEND_ORIGINS=http://localhost:3000
INGESTION_CRON_HOUR=6

# Real Yad2 listings via Apify (https://apify.com) - see README "Apify setup"
# for how to get these. Leave APIFY_API_TOKEN unset to keep using the direct
# Yad2 attempt (blocked in practice) + mock fallback.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
# Only needed if your chosen actor expects a different input shape than the
# default (a list of Yad2 search-result startUrls + maxItems):
APIFY_ACTOR_INPUT_JSON=
APIFY_MAX_ITEMS=200
APIFY_RUN_TIMEOUT_SECONDS=180
